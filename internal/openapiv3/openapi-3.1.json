          "$ref": "http://json-schema.org/draft-04/schema#/properties/minProperties"
        },
        "required": {
          "$ref": "http://json-schema.org/draft-04/schema#/properties/required"
        },
        "enum": {
          "$ref": "http://json-schema.org/draft-04/schema#/properties/enum"
        },
        "type": {
          "type": "string"
        },
        "allOf": {
          "type": "array",
          "items": {
