{
  "title": "A JSON Schema for OpenAPI 3.1.",
  "id": "https://spec.openapis.org/oas/3.1/schema",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "description": "This is the root object of the OpenAPI Description.",
  "required": [
    "openapi",
    "info"
  ],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {
      "$ref": "#/definitions/specificationExtension"
    }
  },
  "properties": {
    "openapi": {
      "type": "string"
    },
    "info": {
      "$ref": "#/definitions/info"
    },
    "jsonSchemaDialect": {
      "type": "string"
    },
    "servers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/server"
      },
      "uniqueItems": true
    },
    "paths": {
      "$ref": "#/definitions/paths"
    },
    "webhooks": {
